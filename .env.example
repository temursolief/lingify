DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lingify?schema=public"
SESSION_SECRET="generate-with-openssl-rand-hex-32"
APP_URL="http://localhost:3000"
# The school's time zone: days, streaks and due dates are counted in it. Set it on the server, which usually runs in UTC.
APP_TIMEZONE="Asia/Tashkent"
# Database connections the server keeps open at most (optional: 2 per copy on Netlify, 10 locally)
DATABASE_POOL_MAX=""
# On Netlify: Neon's direct URL, used for migrations (DATABASE_URL is the pooled "-pooler" one). Empty locally.
DIRECT_DATABASE_URL=""
# Telegram reminders (optional): create a bot with @BotFather
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# Teachers who can upload Anki decks for every student (comma-separated emails)
ADMIN_EMAILS="teacher@lingify.test"
