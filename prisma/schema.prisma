generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
}

enum WordStatus {
  LEARNING
  KNOWN
}

enum WordSource {
  PLACEMENT
  LOOKUP
  REVIEW
}

enum Activity {
  READING
  QUIZ
  VOCAB
  GRAMMAR
  REVIEW
  PLACEMENT
}

enum AttemptKind {
  COMPREHENSION
  VOCAB
  GRAMMAR
  REVIEW
}

enum AssignmentKind {
  TEXT
  GOAL
}

enum GoalType {
  WORDS_WEEK
  TEXTS_WEEK
  MINUTES_WEEK
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role
  topicPrefs     String[]
  placementDone  Boolean   @default(false)
  estimatedVocab Int?
  createdAt      DateTime  @default(now())
  lastActiveAt   DateTime?

  classesTaught Class[]           @relation("TeacherClasses")
  enrollments   Enrollment[]
  words         LemmaState[]
  sessions      ReadingSession[]
  attempts      ExerciseAttempt[]
  activityTime  ActivityTime[]
  snapshots     VocabSnapshot[]
  placements    PlacementTest[]
  goals         Goal[]
  recipients    AssignmentRecipient[]
  events        Event[]
}

model Class {
  id          String       @id @default(cuid())
  name        String
  joinCode    String       @unique
  teacherId   String
  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
  assignments Assignment[]
}

model Enrollment {
  userId   String
  classId  String
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([userId, classId])
}

model Text {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  genre       String
  topics      String[]
  /// Token[][] — one array per paragraph
  paragraphs  Json
  sentences   String[]
  /// { lemma: count }
  lemmaCounts Json
  wordCount   Int
  /// { question, options, answer, explanation }[]
  questions   Json
  /// { structure, explanation, example, exercise }[]
  grammar     Json
  createdAt   DateTime @default(now())

  sessions    ReadingSession[]
  assignments Assignment[]
}

model LemmaState {
  userId          String
  lemma           String
  status          WordStatus
  source          WordSource
  exposures       Int        @default(0)
  lookups         Int        @default(0)
  contextSentence String?
  contextWord     String?
  contextTextId   String?
  srsInterval     Int        @default(0)
  srsEase         Float      @default(2.5)
  srsDue          DateTime?
  srsStreak       Int        @default(0)
  srsReviews      Int        @default(0)
  srsLapses       Int        @default(0)
  knownAt         DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lemma])
  @@index([userId, status, srsDue])
}

model ReadingSession {
  id             String    @id @default(cuid())
  userId         String
  textId         String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  activeSeconds  Int       @default(0)
  wpm            Float?
  coverage       Float
  lookupCount    Int       @default(0)
  quizScore      Float?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text           Text      @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

model ExerciseAttempt {
  id         String      @id @default(cuid())
  userId     String
  textId     String?
  kind       AttemptKind
  itemKey    String
  correct    Boolean
  answeredAt DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, answeredAt])
}

model ActivityTime {
  userId   String
  day      DateTime @db.Date
  activity Activity
  seconds  Int      @default(0)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, activity])
}

model VocabSnapshot {
  userId        String
  day           DateTime @db.Date
  knownCount    Int
  learningCount Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model PlacementTest {
  id          String    @id @default(cuid())
  userId      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// { word, band, pseudo, answer? }[]
  items       Json
  /// { band, known, total, falseAlarms }[]
  results     Json?
  estimate    Int?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  type      GoalType
  target    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assignment {
  id         String                @id @default(cuid())
  classId    String
  kind       AssignmentKind
  textId     String?
  goalType   GoalType?
  target     Int?
  note       String?
  dueAt      DateTime?
  createdAt  DateTime              @default(now())
  class      Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  text       Text?                 @relation(fields: [textId], references: [id], onDelete: Cascade)
  recipients AssignmentRecipient[]
}

model AssignmentRecipient {
  assignmentId String
  studentId    String
  completedAt  DateTime?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, studentId])
}

model DictionaryEntry {
  word      String   @id
  found     Boolean
  /// { phonetic, audio, meanings: { partOfSpeech, definition, example }[] }
  data      Json?
  fetchedAt DateTime @default(now())
}

model Event {
  id     String   @id @default(cuid())
  userId String
  type   String
  textId String?
  data   Json?
  at     DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, at])
}
