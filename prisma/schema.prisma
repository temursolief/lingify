generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
}

enum Activity {
  IELTS
  REVIEW
}

/// Anki card states.
enum CardQueue {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// How strictly a first try is proctored, set per assignment.
enum ProctoringPolicy {
  /// practice: events are recorded, nothing is submitted for the student
  NONE
  /// the first tab switch / fullscreen exit gives a 5-second warning; the second submits
  WARN_ONCE
  /// the first tab switch / fullscreen exit submits the first try
  STRICT
}

/// Why a first try was submitted.
enum SubmissionReason {
  NORMAL
  TIMER_EXPIRED
  TAB_HIDDEN
  WINDOW_BLUR
  FULLSCREEN_EXIT
}

/// Why a student missed a question the first time, chosen after they correct it.
enum ErrorTag {
  VOCAB
  DISTRACTOR
  LOGIC
  CARELESS
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role
  createdAt      DateTime  @default(now())
  lastActiveAt   DateTime?
  /// show Uzbek translations on cards made from passages
  uzbekGlosses   Boolean   @default(true)
  telegramCode   String?   @unique
  telegramChatId String?   @unique
  /// the IELTS band the student is working towards: the end of their band path
  targetBand     Float     @default(7)
  /// XP days from this instant on need recounting (null = XpDay is up to date); see src/lib/gamification.ts
  xpDirtyFrom    DateTime?
  /// bumped by every mark, so a recount only clears the marker when no newer change came in while it ran
  xpDirtySeq     Int       @default(0)

  classesTaught Class[]               @relation("TeacherClasses")
  enrollments   Enrollment[]
  activityTime  ActivityTime[]
  recipients    AssignmentRecipient[]
  ownPassages   Passage[]             @relation("TeacherPassages")
  attempts      PassageAttempt[]
  decks         Deck[]                @relation("DeckOwner")
  lessons       ListeningLesson[]     @relation("LessonOwner")
  listenings    ListeningAttempt[]
  cardStates    CardState[]
  reviewLogs    ReviewLog[]
  ownCards      Card[]                @relation("CardOwner")
  xpDays        XpDay[]
}

model Class {
  id            String       @id @default(cuid())
  name          String
  joinCode      String       @unique
  teacherId     String
  teacher       User         @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  /// the optional weekly XP league inside the class; the shared class goal stays on either way
  leagueEnabled Boolean      @default(true)
  enrollments   Enrollment[]
  assignments   Assignment[]

  @@index([teacherId])
}

model Enrollment {
  userId   String
  classId  String
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([userId, classId])
  @@index([classId])
}

/// An IELTS Academic Reading passage. `ownerId` null = built into Lingify, visible to everyone.
model Passage {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  /// paragraphs, labelled A, B, C… in order
  paragraphs     String[]
  /// QuestionGroup[] in the documented upload format (src/lib/passage-format.ts)
  groups         Json
  timeLimit      Int              @default(20)
  /// kept beside the content so lists show them without loading the passage itself
  paragraphCount Int              @default(0)
  questionCount  Int              @default(0)
  ownerId        String?
  owner          User?            @relation("TeacherPassages", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  /// set instead of deleting, so attempts, decks and review history are kept
  archivedAt     DateTime?
  assignments    Assignment[]
  attempts       PassageAttempt[]
  /// the shared deck for this passage's uploaded cards and students' own highlights, if any
  deck           Deck?

  @@index([ownerId])
}

/// A passage or a listening lesson given to a class: exactly one of passageId/lessonId is set.
model Assignment {
  id                String                @id @default(cuid())
  classId           String
  passageId         String?
  lessonId          String?
  note              String?
  dueAt             DateTime?
  proctoringPolicy  ProctoringPolicy      @default(STRICT)
  /// homework is done only once the linked deck's cards for today are cleared (passage) or the key words read (lesson)
  requireVocabFirst Boolean               @default(true)
  createdAt         DateTime              @default(now())
  class             Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  passage           Passage?              @relation(fields: [passageId], references: [id], onDelete: Cascade)
  lesson            ListeningLesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  recipients        AssignmentRecipient[]

  @@index([classId])
  @@index([passageId])
  @@index([lessonId])
}

model AssignmentRecipient {
  assignmentId     String
  studentId        String
  completedAt      DateTime?
  /// when the timed first try was submitted
  firstSubmitAt    DateTime?
  /// when the linked deck's cards for the day were cleared, or the lesson's key words read
  vocabCompletedAt DateTime?
  integrityFlagged Boolean    @default(false)
  assignment       Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student          User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, studentId])
  @@index([studentId])
}

/// One student working through one passage: a timed first submission, then corrections until every answer is green.
model PassageAttempt {
  id               String           @id @default(cuid())
  userId           String
  passageId        String
  startedAt        DateTime         @default(now())
  /// first submission: the exam-like score
  firstSubmittedAt DateTime?
  firstSeconds     Int?
  firstCorrect     Int?
  total            Int
  band             Float?
  /// every question answered correctly
  completedAt      DateTime?
  /// when the student pressed "Start test" (server clock): the timer and the pacing checks count from here
  testStartedAt    DateTime?
  submissionReason SubmissionReason @default(NORMAL)
  integrityFlagged Boolean          @default(false)
  /// UNREALISTIC_SPEED_HIGH_SCORE, ANSWER_KEY_SUSPECTED, LOCATING_SKILL_MISMATCH, TAB_HIDDEN, …
  integrityReasons String[]         @default([])
  /// { type, atMs, questionNumber? }[] recorded in the browser during the first try (src/lib/telemetry.ts)
  integrityEvents  Json             @default("[]")
  /// AttemptTelemetry (src/lib/telemetry.ts), sent with the first submission
  telemetry        Json             @default("{}")
  /// set when a teacher required a retake; the attempt is kept but left out of scores and analytics
  invalidatedAt    DateTime?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage          Passage          @relation(fields: [passageId], references: [id], onDelete: Cascade)
  answers          QuestionAnswer[]

  @@index([userId, passageId])
  @@index([passageId])
}

/// The state of one question in an attempt, with every try kept for the teacher.
model QuestionAnswer {
  attemptId    String
  number       Int
  type         String
  answer       String
  correct      Boolean
  firstCorrect Boolean
  tries        Int            @default(1)
  /// { paragraph, start, end, text } where the student showed their proof for the latest try
  evidence     Json?
  /// the student's proof was in the paragraph the teacher marked as evidence
  evidenceOk   Boolean?
  errorTag     ErrorTag?
  /// { answer, correct, evidence, at }[]
  history      Json           @default("[]")
  attempt      PassageAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, number])
}

/// A Listening Comprehension lesson: a YouTube video (e.g. TED-Ed), IELTS Listening questions and key vocabulary,
/// all from one JSON file uploaded by a teacher. Kept as one row so a lesson page is a single read.
model ListeningLesson {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  videoId     String
  /// QuestionGroup[] (src/lib/listening-format.ts); answers never leave the server
  questions   Json
  /// { word, meaning, uz?, example? }[]
  vocabulary  Json               @default("[]")
  total       Int
  /// number of key words, so lists do not load the vocabulary
  wordCount   Int                @default(0)
  ownerId     String?
  owner       User?              @relation("LessonOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  archivedAt  DateTime?
  attempts    ListeningAttempt[]
  assignments Assignment[]
  /// the shared deck for this lesson's key words, if any
  deck        Deck?

  @@index([ownerId])
}

/// One student working on one lesson. Every question's state lives in one JSON column, so checking an answer
/// reads and writes a single row.
model ListeningAttempt {
  id               String           @id @default(cuid())
  userId           String
  lessonId         String
  startedAt        DateTime         @default(now())
  firstSubmittedAt DateTime?
  firstCorrect     Int?
  band             Float?
  completedAt      DateTime?
  /// set once the student has pressed "I've read these words"; the questions stay hidden until then
  vocabSeenAt      DateTime?
  /// when the student pressed "Start test" (server clock): the timer and the pacing checks count from here
  testStartedAt    DateTime?
  submissionReason SubmissionReason @default(NORMAL)
  integrityFlagged Boolean          @default(false)
  /// UNREALISTIC_SPEED_HIGH_SCORE, ANSWER_KEY_SUSPECTED, LOCATING_SKILL_MISMATCH, TAB_HIDDEN, …
  integrityReasons String[]         @default([])
  /// { type, atMs, questionNumber? }[] recorded in the browser during the first try (src/lib/telemetry.ts)
  integrityEvents  Json             @default("[]")
  /// AttemptTelemetry (src/lib/telemetry.ts), sent with the first submission
  telemetry        Json             @default("{}")
  /// set when a teacher required a retake; the attempt is kept but left out of scores and analytics
  invalidatedAt    DateTime?
  /// { [number]: { answer, correct, firstCorrect, tries, wrong: string[] } }
  answers          Json             @default("{}")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson           ListeningLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([lessonId])
}

/// An Anki deck: a student's own (`ownerId` unique), one shared deck per passage or lesson (`passageId`/`lessonId`
/// unique), or, for decks uploaded before those existed, a deck shared with every student (all three null).
model Deck {
  id         String           @id @default(cuid())
  name       String
  ownerId    String?          @unique
  owner      User?            @relation("DeckOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  passageId  String?          @unique
  passage    Passage?         @relation(fields: [passageId], references: [id], onDelete: Cascade)
  lessonId   String?          @unique
  lesson     ListeningLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// card styling from the Anki note types: { [noteTypeId]: css }
  css        Json             @default("{}")
  createdAt  DateTime         @default(now())
  archivedAt DateTime?
  cards      Card[]
  media      DeckMedia[]
}

model Card {
  id         String      @id @default(cuid())
  deckId     String
  /// rendered question and answer HTML
  front      String
  back       String
  noteType   String      @default("")
  /// order cards are introduced in (Anki's "due" for new cards)
  position   Int         @default(0)
  /// empty for a deck's own cards (the teacher's upload or a lesson's key words), the student's ID for their own
  /// highlight card in a shared deck
  ownerId    String?
  owner      User?       @relation("CardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// the Anki note this card came from, so re-uploading the same .apkg updates it instead of duplicating it
  ankiNoteId String?
  createdAt  DateTime    @default(now())
  deck       Deck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  states     CardState[]
  logs       ReviewLog[]

  @@index([deckId, position])
  @@index([ownerId])
  @@index([deckId, ankiNoteId])
}

model DeckMedia {
  deckId String
  name   String
  mime   String
  data   Bytes
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([deckId, name])
}

/// One student's schedule for one card (Anki SM-2 with a 20-day maximum interval).
model CardState {
  userId   String
  cardId   String
  queue    CardQueue @default(NEW)
  due      DateTime
  /// days, for review cards
  interval Int       @default(0)
  /// ease factor in permille, like Anki (2500 = 250%)
  ease     Int       @default(2500)
  reps     Int       @default(0)
  lapses   Int       @default(0)
  /// index into the learning/relearning steps
  step     Int       @default(0)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@index([userId, due])
  @@index([cardId])
}

model ReviewLog {
  id         String    @id @default(cuid())
  userId     String
  cardId     String
  /// 1 Again, 2 Hard, 3 Good, 4 Easy
  rating     Int
  queue      CardQueue
  interval   Int
  /// card shown → rating pressed, capped at 60 s; 0 = not measured (older reviews)
  durationMs Int       @default(0)
  at         DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([cardId])
}

model ActivityTime {
  userId   String
  day      DateTime @db.Date
  activity Activity
  seconds  Int      @default(0)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, activity])
}

model DictionaryEntry {
  word      String   @id
  found     Boolean
  /// { phonetic, audio, meanings: { partOfSpeech, definition, example }[] }
  data      Json?
  fetchedAt DateTime @default(now())
}

/// Meanings found for chunks highlighted in passages (glossary or dictionary), cached so each chunk/sentence pair costs once.
model ChunkMeaning {
  key       String   @id
  meaning   String
  uz        String?
  createdAt DateTime @default(now())
}

/// One student's XP and quest counts for one calendar day (app time zone): a rollup of the events in
/// src/lib/gamification.ts, recounted from the first changed day whenever User.xpDirtyFrom is set.
model XpDay {
  userId String
  day    DateTime @db.Date
  /// the day's net change in TENTHS of a point (earned minus what the day cost, floored at the current stage's start)
  xp     Int      @default(0)
  first  Int      @default(0)
  proofs Int      @default(0)
  cards  Int      @default(0)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}
