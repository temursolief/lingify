generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
}

enum Activity {
  IELTS
  REVIEW
}

/// Anki card states.
enum CardQueue {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// Why a student missed a question the first time, chosen after they correct it.
enum ErrorTag {
  VOCAB
  DISTRACTOR
  LOGIC
  CARELESS
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role
  createdAt      DateTime  @default(now())
  lastActiveAt   DateTime?
  /// show Uzbek translations on cards made from passages
  uzbekGlosses   Boolean   @default(true)
  telegramCode   String?   @unique
  telegramChatId String?   @unique

  classesTaught Class[]               @relation("TeacherClasses")
  enrollments   Enrollment[]
  activityTime  ActivityTime[]
  recipients    AssignmentRecipient[]
  ownPassages   Passage[]             @relation("TeacherPassages")
  attempts      PassageAttempt[]
  decks         Deck[]                @relation("DeckOwner")
  lessons       ListeningLesson[]     @relation("LessonOwner")
  listenings    ListeningAttempt[]
  cardStates    CardState[]
  reviewLogs    ReviewLog[]
  ownCards      Card[]                @relation("CardOwner")
}

model Class {
  id          String       @id @default(cuid())
  name        String
  joinCode    String       @unique
  teacherId   String
  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
  assignments Assignment[]

  @@index([teacherId])
}

model Enrollment {
  userId   String
  classId  String
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([userId, classId])
  @@index([classId])
}

/// An IELTS Academic Reading passage. `ownerId` null = built into Lingify, visible to everyone.
model Passage {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  /// paragraphs, labelled A, B, C… in order
  paragraphs     String[]
  /// QuestionGroup[] in the documented upload format (src/lib/passage-format.ts)
  groups         Json
  timeLimit      Int              @default(20)
  /// kept beside the content so lists show them without loading the passage itself
  paragraphCount Int              @default(0)
  questionCount  Int              @default(0)
  ownerId        String?
  owner          User?            @relation("TeacherPassages", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  assignments    Assignment[]
  attempts       PassageAttempt[]
  /// the shared deck for this passage's uploaded cards and students' own highlights, if any
  deck           Deck?

  @@index([ownerId])
}

/// A passage or a listening lesson given to a class: exactly one of passageId/lessonId is set.
model Assignment {
  id         String                @id @default(cuid())
  classId    String
  passageId  String?
  lessonId   String?
  note       String?
  dueAt      DateTime?
  createdAt  DateTime              @default(now())
  class      Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  passage    Passage?              @relation(fields: [passageId], references: [id], onDelete: Cascade)
  lesson     ListeningLesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  recipients AssignmentRecipient[]

  @@index([classId])
  @@index([passageId])
  @@index([lessonId])
}

model AssignmentRecipient {
  assignmentId String
  studentId    String
  completedAt  DateTime?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, studentId])
  @@index([studentId])
}

/// One student working through one passage: a timed first submission, then corrections until every answer is green.
model PassageAttempt {
  id               String           @id @default(cuid())
  userId           String
  passageId        String
  startedAt        DateTime         @default(now())
  /// first submission: the exam-like score
  firstSubmittedAt DateTime?
  firstSeconds     Int?
  firstCorrect     Int?
  total            Int
  band             Float?
  /// every question answered correctly
  completedAt      DateTime?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage          Passage          @relation(fields: [passageId], references: [id], onDelete: Cascade)
  answers          QuestionAnswer[]

  @@index([userId, passageId])
  @@index([passageId])
}

/// The state of one question in an attempt, with every try kept for the teacher.
model QuestionAnswer {
  attemptId    String
  number       Int
  type         String
  answer       String
  correct      Boolean
  firstCorrect Boolean
  tries        Int            @default(1)
  /// { paragraph, start, end, text } where the student showed their proof for the latest try
  evidence     Json?
  /// the student's proof was in the paragraph the teacher marked as evidence
  evidenceOk   Boolean?
  errorTag     ErrorTag?
  /// { answer, correct, evidence, at }[]
  history      Json           @default("[]")
  attempt      PassageAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, number])
}

/// A Listening Comprehension lesson: a YouTube video (e.g. TED-Ed), IELTS Listening questions and key vocabulary,
/// all from one JSON file uploaded by a teacher. Kept as one row so a lesson page is a single read.
model ListeningLesson {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  videoId     String
  /// QuestionGroup[] (src/lib/listening-format.ts); answers never leave the server
  questions   Json
  /// { word, meaning, uz?, example? }[]
  vocabulary  Json               @default("[]")
  total       Int
  /// number of key words, so lists do not load the vocabulary
  wordCount   Int                @default(0)
  ownerId     String?
  owner       User?              @relation("LessonOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  attempts    ListeningAttempt[]
  assignments Assignment[]
  /// the shared deck for this lesson's key words, if any
  deck        Deck?

  @@index([ownerId])
}

/// One student working on one lesson. Every question's state lives in one JSON column, so checking an answer
/// reads and writes a single row.
model ListeningAttempt {
  id               String          @id @default(cuid())
  userId           String
  lessonId         String
  startedAt        DateTime        @default(now())
  firstSubmittedAt DateTime?
  firstCorrect     Int?
  band             Float?
  completedAt      DateTime?
  /// set once the student has pressed "I've read these words"; the questions stay hidden until then
  vocabSeenAt      DateTime?
  /// { [number]: { answer, correct, firstCorrect, tries, wrong: string[] } }
  answers          Json            @default("{}")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson           ListeningLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([lessonId])
}

/// An Anki deck: a student's own (`ownerId` unique), one shared deck per passage or lesson (`passageId`/`lessonId`
/// unique), or, for decks uploaded before those existed, a deck shared with every student (all three null).
model Deck {
  id        String           @id @default(cuid())
  name      String
  ownerId   String?          @unique
  owner     User?            @relation("DeckOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  passageId String?          @unique
  passage   Passage?         @relation(fields: [passageId], references: [id], onDelete: Cascade)
  lessonId  String?          @unique
  lesson    ListeningLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// card styling from the Anki note types: { [noteTypeId]: css }
  css       Json             @default("{}")
  createdAt DateTime         @default(now())
  cards     Card[]
  media     DeckMedia[]
}

model Card {
  id         String      @id @default(cuid())
  deckId     String
  /// rendered question and answer HTML
  front      String
  back       String
  noteType   String      @default("")
  /// order cards are introduced in (Anki's "due" for new cards)
  position   Int         @default(0)
  /// empty for a deck's own cards (the teacher's upload or a lesson's key words), the student's ID for their own
  /// highlight card in a shared deck
  ownerId    String?
  owner      User?       @relation("CardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// the Anki note this card came from, so re-uploading the same .apkg updates it instead of duplicating it
  ankiNoteId String?
  createdAt  DateTime    @default(now())
  deck       Deck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  states     CardState[]
  logs       ReviewLog[]

  @@index([deckId, position])
  @@index([ownerId])
  @@index([deckId, ankiNoteId])
}

model DeckMedia {
  deckId String
  name   String
  mime   String
  data   Bytes
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([deckId, name])
}

/// One student's schedule for one card (Anki SM-2 with a 20-day maximum interval).
model CardState {
  userId   String
  cardId   String
  queue    CardQueue @default(NEW)
  due      DateTime
  /// days, for review cards
  interval Int       @default(0)
  /// ease factor in permille, like Anki (2500 = 250%)
  ease     Int       @default(2500)
  reps     Int       @default(0)
  lapses   Int       @default(0)
  /// index into the learning/relearning steps
  step     Int       @default(0)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@index([userId, due])
  @@index([cardId])
}

model ReviewLog {
  id       String    @id @default(cuid())
  userId   String
  cardId   String
  /// 1 Again, 2 Hard, 3 Good, 4 Easy
  rating   Int
  queue    CardQueue
  interval Int
  at       DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([cardId])
}

model ActivityTime {
  userId   String
  day      DateTime @db.Date
  activity Activity
  seconds  Int      @default(0)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, activity])
}

model DictionaryEntry {
  word      String   @id
  found     Boolean
  /// { phonetic, audio, meanings: { partOfSpeech, definition, example }[] }
  data      Json?
  fetchedAt DateTime @default(now())
}

/// Meanings written by the AI for chunks highlighted in passages, cached so each chunk/sentence pair costs once.
model ChunkMeaning {
  key       String   @id
  meaning   String
  uz        String?
  createdAt DateTime @default(now())
}
