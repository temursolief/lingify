generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
}

enum WordStatus {
  LEARNING
  KNOWN
}

enum WordSource {
  PLACEMENT
  LOOKUP
  REVIEW
}

enum Activity {
  READING
  QUIZ
  VOCAB
  GRAMMAR
  REVIEW
  PLACEMENT
  FLUENCY
}

enum AttemptKind {
  COMPREHENSION
  VOCAB
  GRAMMAR
  REVIEW
  GIST
  GUESS
  CCQ
  DISCOVERY
  PHRASE
}

enum AbandonReason {
  TOO_HARD
  NOT_INTERESTED
  NO_TIME
}

enum AssignmentKind {
  TEXT
  GOAL
}

enum GoalType {
  WORDS_WEEK
  TEXTS_WEEK
  MINUTES_WEEK
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role
  topicPrefs     String[]
  placementDone  Boolean   @default(false)
  estimatedVocab Int?
  createdAt      DateTime  @default(now())
  lastActiveAt   DateTime?

  classesTaught Class[]               @relation("TeacherClasses")
  enrollments   Enrollment[]
  words         LemmaState[]
  sessions      ReadingSession[]
  attempts      ExerciseAttempt[]
  activityTime  ActivityTime[]
  snapshots     VocabSnapshot[]
  placements    PlacementTest[]
  goals         Goal[]
  recipients    AssignmentRecipient[]
  events        Event[]
  ratings       TextRating[]
  fluencyRuns   FluencyRun[]
}

model Class {
  id          String       @id @default(cuid())
  name        String
  joinCode    String       @unique
  teacherId   String
  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
  assignments Assignment[]
}

model Enrollment {
  userId   String
  classId  String
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([userId, classId])
}

model Text {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  genre       String
  topics      String[]
  /// Token[][] — one array per paragraph
  paragraphs  Json
  sentences   String[]
  /// { lemma: count }
  lemmaCounts Json
  wordCount   Int
  /// { question, options, answer, explanation }[]
  questions   Json
  /// { key, structure, explanation, example, examples, marks, discovery, exercise }[]
  grammar     Json
  leadIn      String   @default("")
  /// { question, options, answer }
  prediction  Json?
  /// { word, lemma, definition, ccq: { question, options, answer } }[]
  preTeach    Json     @default("[]")
  /// { question, options, answer, explanation }
  gist        Json?
  response    String   @default("")
  /// { phrase, meaning, marks }[]
  phrases     Json     @default("[]")
  series      String?
  seriesPart  Int?
  createdAt   DateTime @default(now())

  sessions    ReadingSession[]
  assignments Assignment[]
  ratings     TextRating[]
  fluencyRuns FluencyRun[]
}

model LemmaState {
  userId          String
  lemma           String
  status          WordStatus
  source          WordSource
  exposures       Int        @default(0)
  lookups         Int        @default(0)
  contextSentence String?
  contextWord     String?
  contextTextId   String?
  srsInterval     Int        @default(0)
  srsEase         Float      @default(2.5)
  srsDue          DateTime?
  srsStreak       Int        @default(0)
  srsReviews      Int        @default(0)
  srsLapses       Int        @default(0)
  /// multi-word phrase saved from a text (not counted in coverage)
  isPhrase        Boolean    @default(false)
  meaning         String?
  knownAt         DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lemma])
  @@index([userId, status, srsDue])
}

model ReadingSession {
  id            String         @id @default(cuid())
  userId        String
  textId        String
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  activeSeconds Int            @default(0)
  wpm           Float?
  coverage      Float
  lookupCount   Int            @default(0)
  quizScore     Float?
  prediction    Int?
  gistCorrect   Boolean?
  abandonedAt   DateTime?
  abandonReason AbandonReason?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  text          Text           @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

model ExerciseAttempt {
  id         String      @id @default(cuid())
  userId     String
  textId     String?
  kind       AttemptKind
  itemKey    String
  correct    Boolean
  /// reading sub-skill for comprehension questions, grammar key for grammar items
  skill      String?
  answeredAt DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, answeredAt])
}

model ActivityTime {
  userId   String
  day      DateTime @db.Date
  activity Activity
  seconds  Int      @default(0)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, activity])
}

model VocabSnapshot {
  userId        String
  day           DateTime @db.Date
  knownCount    Int
  learningCount Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model PlacementTest {
  id          String    @id @default(cuid())
  userId      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// { word, band, pseudo, answer? }[]
  items       Json
  /// { band, known, total, falseAlarms }[]
  results     Json?
  estimate    Int?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  type      GoalType
  target    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assignment {
  id         String                @id @default(cuid())
  classId    String
  kind       AssignmentKind
  textId     String?
  goalType   GoalType?
  target     Int?
  note       String?
  dueAt      DateTime?
  createdAt  DateTime              @default(now())
  class      Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  text       Text?                 @relation(fields: [textId], references: [id], onDelete: Cascade)
  recipients AssignmentRecipient[]
}

model AssignmentRecipient {
  assignmentId String
  studentId    String
  completedAt  DateTime?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, studentId])
}

model DictionaryEntry {
  word      String   @id
  found     Boolean
  /// { phonetic, audio, meanings: { partOfSpeech, definition, example }[] }
  data      Json?
  fetchedAt DateTime @default(now())
}

model Event {
  id     String   @id @default(cuid())
  userId String
  type   String
  textId String?
  data   Json?
  at     DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, at])
}

model TextRating {
  userId     String
  textId     String
  /// 1 = not for me, 2 = it was OK, 3 = loved it
  enjoyment  Int
  /// -1 too easy, 0 just right, 1 too hard
  difficulty Int
  recommend  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       Text     @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@id([userId, textId])
}

model FluencyRun {
  id          String   @id @default(cuid())
  userId      String
  textId      String
  seconds     Int
  wpm         Float
  gistCorrect Boolean?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        Text     @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
